NODE_ENV=development
PORT=4000

MONGO_DB_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=Make_My_Marriage

# Generate a private value with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-private-random-value-of-at-least-32-bytes
SESSION_COOKIE_NAME=mmm.sid
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=604800000
SESSION_COLLECTION_NAME=sessions

# Production must set this to the exact deployed frontend origin.
FRONTEND_ORIGIN=http://localhost:5173
# Set TRUST_PROXY to the trusted proxy hop count only when deployed behind a proxy.
# TRUST_PROXY=1

# Implementation defaults (tune for deployment; not product policy).
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MS=3600000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=10
