{
  "name": "@make-my-marriage/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src test",
    "test": "vitest run --exclude '**/*.integration.test.mjs'",
    "test:models:integration": "vitest run test/models-index.integration.test.mjs",
    "test:auth:integration": "vitest run test/auth.integration.test.mjs",
    "test:wedding:integration": "vitest run test/wedding.integration.test.mjs",
    "test:wedding-images:integration": "vitest run test/wedding-images.integration.test.mjs",
    "test:events:integration": "vitest run test/events.integration.test.mjs",
    "test:tasks:integration": "vitest run test/tasks.integration.test.mjs",
    "test:expenses:integration": "vitest run test/expenses.integration.test.mjs",
    "test:guests:integration": "vitest run test/guests.integration.test.mjs",
    "test:invitations:integration": "vitest run test/invitations.integration.test.mjs",
    "test:rsvp:integration": "vitest run test/rsvp.integration.test.mjs",
    "test:dashboard:integration": "vitest run test/dashboard.integration.test.mjs",
    "test:announcements:integration": "vitest run test/announcements.integration.test.mjs",
    "test:photos:integration": "vitest run test/photos.integration.test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
